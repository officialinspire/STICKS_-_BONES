{
  "name": "sticks-and-bones",
  "private": true,
  "version": "0.1.0",
  "description": "STICKS & BONES — traditional Puerto Rican dominoes hosted by Roberto aka Cousin.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:verify": "tsx scripts/verify-assets.ts",
    "assets:measure": "tsx scripts/verify-assets.ts --measure",
    "check": "npm run typecheck && npm run lint && npm run test && npm run assets:verify && npm run build",
    "atlas:build": "tsx scripts/build-atlas.ts",
    "assets:derive": "tsx scripts/build-derivatives.ts",
    "icons:build": "tsx scripts/build-icons.ts",
    "story:build": "tsx scripts/build-story.ts",
    "story:e2e": "tsx scripts/story.ts",
    "audio": "tsx scripts/audio.ts",
    "pwa": "tsx scripts/pwa.ts",
    "matches": "tsx scripts/matches.ts",
    "smoke": "tsx scripts/smoke.ts",
    "qa": "tsx scripts/qa.ts",
    "a11y": "tsx scripts/a11y.ts",
    "perf": "tsx scripts/perf.ts",
    "e2e": "tsx scripts/e2e.ts",
    "ai:tournament": "tsx scripts/ai-tournament.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
